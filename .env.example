# Genera con: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=genera-con-python-secrets-token-hex-32

DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL: postgres://usuario:contraseña@host:puerto/nombre_bd
DATABASE_URL=postgres://tension_user:password@localhost:5432/tension

# Claude API — https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-...

# Email (usa console backend en desarrollo)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=tu@email.com
